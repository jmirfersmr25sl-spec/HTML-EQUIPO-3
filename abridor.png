<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 326" role="img" aria-label="Abridor ergonómico impreso en 3D sobre un tarro" xmlns:c2pa="http://c2pa.org/manifest">
  <defs>
    <linearGradient id="fondo" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#1b263b"/><stop offset="1" stop-color="#0d1b2a"/></linearGradient>
    <linearGradient id="vidrio" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#cbd5e1" stop-opacity=".55"/><stop offset=".35" stop-color="#f1f5f9" stop-opacity=".25"/><stop offset="1" stop-color="#cbd5e1" stop-opacity=".5"/></linearGradient>
    <pattern id="capas" width="6" height="6" patternUnits="userSpaceOnUse"><rect width="6" height="3" fill="#000" opacity=".12"/></pattern>
  </defs>
  <rect width="600" height="326" fill="url(#fondo)"/>
  <ellipse cx="300" cy="290" rx="190" ry="14" fill="#000" opacity=".35"/>
  <!-- tarro -->
  <rect x="195" y="120" width="210" height="165" rx="26" fill="url(#vidrio)" stroke="#cbd5e1" stroke-width="2"/>
  <rect x="215" y="190" width="170" height="70" rx="8" fill="#fff" opacity=".9"/>
  <text x="300" y="222" text-anchor="middle" font-family="Georgia,serif" font-size="20" fill="#0d1b2a">Mermelada</text>
  <text x="300" y="244" text-anchor="middle" font-family="Arial,sans-serif" font-size="12" fill="#475569">de casa</text>
  <!-- tapa -->
  <rect x="205" y="98" width="190" height="30" rx="8" fill="#94a3b8"/>
  <rect x="205" y="98" width="190" height="30" rx="8" fill="url(#capas)"/>
  <!-- abridor impreso en 3D -->
  <g>
    <ellipse cx="300" cy="94" rx="112" ry="26" fill="#d90429"/>
    <ellipse cx="300" cy="94" rx="112" ry="26" fill="url(#capas)"/>
    <ellipse cx="300" cy="88" rx="86" ry="17" fill="#ef233c"/>
    <path d="M300 88 C 300 50, 440 30, 520 52 C 548 60, 548 92, 520 98 C 450 110, 340 100, 300 94 Z" fill="#d90429"/>
    <path d="M300 88 C 300 50, 440 30, 520 52 C 548 60, 548 92, 520 98 C 450 110, 340 100, 300 94 Z" fill="url(#capas)"/>
    <ellipse cx="505" cy="75" rx="18" ry="12" fill="#0d1b2a"/>
  </g>
  <text x="300" y="316" text-anchor="middle" font-family="Arial,sans-serif" font-size="11" fill="#94a3b8">Palanca larga y agarre ancho: menos fuerza en la muñeca</text>
<metadata><c2pa:manifest></c2pa:manifest></metadata></svg>
